            { id: 16, name: "Agence Gabès",                     gov: "Gabès",     address: "Av. Farhat Hached, Gabès 6000",                   lat: 33.8815, lng: 10.0982, phone: "+216 75 270 900", email: "gabes@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 17, name: "Agence Kairouan",                  gov: "Kairouan",  address: "Av. de la République, Kairouan 3100",              lat: 35.6781, lng: 10.0963, phone: "+216 77 226 500", email: "kairouan@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 18, name: "Agence Béja",                      gov: "Béja",      address: "Av. Habib Bourguiba, Béja 9000",                  lat: 36.7256, lng: 9.1817,  phone: "+216 78 455 200", email: "beja@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 19, name: "Agence Jendouba",                  gov: "Jendouba",  address: "Av. Habib Bourguiba, Jendouba 8100",               lat: 36.5011, lng: 8.7802,  phone: "+216 78 603 100", email: "jendouba@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 20, name: "Agence Le Kef",                    gov: "Le Kef",    address: "Rue 18 Janvier 1952, Le Kef 7100",                 lat: 36.1746, lng: 8.7098,  phone: "+216 78 224 300", email: "lekef@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 21, name: "Agence Gafsa",                     gov: "Gafsa",     address: "Av. Habib Bourguiba, Gafsa 2100",                 lat: 34.4250, lng: 8.7842,  phone: "+216 76 224 600", email: "gafsa@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 22, name: "Agence Tozeur",                    gov: "Tozeur",    address: "Av. Farhat Hached, Tozeur 2200",                   lat: 33.9197, lng: 8.1337,  phone: "+216 76 452 100", email: "tozeur@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 23, name: "Agence Médenine",                  gov: "Médenine",  address: "Av. Habib Bourguiba, Médenine 4100",               lat: 33.3549, lng: 10.5055, phone: "+216 75 640 200", email: "medenine@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 24, name: "Agence Djerba",                    gov: "Médenine",  address: "Zone touristique, Houmt Souk, Djerba 4180",        lat: 33.8750, lng: 10.8578, phone: "+216 75 650 800", email: "djerba@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
