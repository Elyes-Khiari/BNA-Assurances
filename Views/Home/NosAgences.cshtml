            { id: 26, name: "Agence Siliana",                   gov: "Siliana",   address: "Av. de la Liberté, Siliana 6100",                  lat: 36.0849, lng: 9.3748,  phone: "+216 78 872 100", email: "siliana@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 27, name: "Agence Kasserine",                 gov: "Kasserine", address: "Av. Habib Bourguiba, Kasserine 1200",               lat: 35.1676, lng: 8.8308,  phone: "+216 77 474 200", email: "kasserine@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 28, name: "Agence Sidi Bouzid",               gov: "Sidi Bouzid", address: "Av. de la République, Sidi Bouzid 9100",         lat: 34.9311, lng: 9.4838,  phone: "+216 76 625 300", email: "sidibouzid@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 29, name: "Agence Zaghouan",                  gov: "Zaghouan",  address: "Av. Habib Bourguiba, Zaghouan 1100",               lat: 36.4029, lng: 10.1429, phone: "+216 72 675 100", email: "zaghouan@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 30, name: "Agence Kébili",                    gov: "Kébili",    address: "Av. Farhat Hached, Kébili 4200",                   lat: 33.7050, lng: 8.9650,  phone: "+216 75 490 200", email: "kebili@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
        ];

        // ══════════════════════════════════════════════════════════════════
        // INIT MAP
        // ══════════════════════════════════════════════════════════════════
        const map = L.map('agencyMap', { zoomControl: false }).setView([34.5, 9.5], 7);

        L.control.zoom({ position: 'topright' }).addTo(map);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18
        }).addTo(map);

        // ── Marker management ─────────────────────────────────────────
        const markers = {};
        let selectedId = null;
        let userLatLng = null;
        let userMarkerLayer = null;

        function createMarkerIcon(active) {
            return L.divIcon({
                className: '',
                html: `<div class="bna-marker ${active ? 'active' : ''}"></div>`,
                iconSize: [32, 32],
                iconAnchor: [16, 16],
                popupAnchor: [0, -20]
            });
        }

        agencies.forEach(a => {
            const m = L.marker([a.lat, a.lng], { icon: createMarkerIcon(false) }).addTo(map);
            m.bindPopup(buildPopupHtml(a), { maxWidth: 280, closeButton: true });
            m.on('click', () => selectAgency(a.id));
            markers[a.id] = m;
        });

        // ── Populate govFilter ────────────────────────────────────────
        const govs = [...new Set(agencies.map(a => a.gov))].sort();
        const govFilter = document.getElementById('govFilter');
        govs.forEach(g => {
            const opt = document.createElement('option');
            opt.value = g; opt.textContent = g;
            govFilter.appendChild(opt);
        });

        document.getElementById('totalAgencies').textContent = agencies.length;

        // ══════════════════════════════════════════════════════════════════
        // HELPERS
        // ══════════════════════════════════════════════════════════════════
        function isOpenNow(a) {
            const now = new Date();
            const day = now.getDay(); // 0=Sun
            if (day === 0 || day === 6) return false;
            const h = now.getHours();
            return h >= a.hours.open && h < a.hours.close;
        }

        function haversineKm(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLon/2)**2;
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        }

        function buildPopupHtml(a) {
            const open = isOpenNow(a);
            return `<div class="popup-inner">
                <h3>${a.name}</h3>
                <p>${a.address}</p>
                <p style="margin-top:6px"><span class="status-badge ${open ? 'open' : 'closed'}"><span class="status-dot ${open ? 'open' : 'closed'}"></span>${open ? 'Ouvert' : 'Fermé'}</span></p>
                <p style="margin-top:8px;font-size:.8rem;color:#0D2F5E;font-weight:600"><a href="tel:${a.phone.replace(/\s/g,'')}" style="color:#0D2F5E;text-decoration:none">📞 ${a.phone}</a></p>
                <div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap">
                    <a href="https://www.google.com/maps/dir/?api=1&destination=${a.lat},${a.lng}" target="_blank" class="action-btn primary" style="font-size:.75rem">Itinéraire</a>
                    <a href="tel:${a.phone.replace(/\s/g,'')}" class="action-btn" style="font-size:.75rem">Appeler</a>
                </div>
            </div>`;
        }

        // ══════════════════════════════════════════════════════════════════
        // RENDER AGENCY CARDS
        // ══════════════════════════════════════════════════════════════════
        function renderCards(list) {
            const container = document.getElementById('agencyList');
            container.innerHTML = '';

            if (list.length === 0) {
                container.innerHTML = '<div class="text-center py-10 text-slate-400"><i data-lucide="search-x" class="mx-auto h-10 w-10 mb-3 opacity-40"></i><p class="font-semibold">Aucune agence trouvée</p><p class="text-sm mt-1">Essayez d\'autres termes de recherche.</p></div>';
                if (window.lucide) window.lucide.createIcons();
                return;
            }

            list.forEach(a => {
                const open = isOpenNow(a);
                const distHtml = a._dist != null ? `<span class="distance-badge"><i data-lucide="navigation" class="h-3 w-3"></i>${a._dist.toFixed(1)} km</span>` : '';
                const card = document.createElement('div');
                card.className = `agency-card ${selectedId === a.id ? 'selected' : ''}`;
                card.dataset.id = a.id;
                card.innerHTML = `
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="font-display text-sm font-extrabold text-bnaNavy leading-snug">${a.name}</h3>
                            <p class="mt-1 text-xs text-slate-500">${a.address}</p>
                        </div>
                        <span class="status-badge ${open ? 'open' : 'closed'} flex-shrink-0">
                            <span class="status-dot ${open ? 'open' : 'closed'}"></span>${open ? 'Ouvert' : 'Fermé'}
                        </span>
                    </div>
                    <div class="mt-3 flex items-center gap-2 flex-wrap">
                        ${distHtml}
                        <span class="text-xs font-medium text-slate-400">${a.gov}</span>
                    </div>
                    <div class="mt-3 flex gap-2 flex-wrap">
                        <a href="https://www.google.com/maps/dir/?api=1&destination=${a.lat},${a.lng}" target="_blank" class="action-btn primary" onclick="event.stopPropagation()">
                            <i data-lucide="navigation" class="h-3.5 w-3.5"></i> Itinéraire
                        </a>
                        <a href="tel:${a.phone.replace(/\s/g,'')}" class="action-btn" onclick="event.stopPropagation()">
                            <i data-lucide="phone" class="h-3.5 w-3.5"></i> Appeler
                        </a>
                        <a href="mailto:${a.email}" class="action-btn" onclick="event.stopPropagation()">
                            <i data-lucide="mail" class="h-3.5 w-3.5"></i> E-mail
                        </a>
                    </div>
                `;
                card.addEventListener('click', () => selectAgency(a.id));
                container.appendChild(card);
            });

            document.getElementById('resultsCount').textContent = `${list.length} agence${list.length > 1 ? 's' : ''} trouvée${list.length > 1 ? 's' : ''}`;
            if (window.lucide) window.lucide.createIcons();
        }

        // ══════════════════════════════════════════════════════════════════
        // SELECT AGENCY
        // ══════════════════════════════════════════════════════════════════
        function selectAgency(id) {
            // Deselect previous
            if (selectedId && markers[selectedId]) {
                markers[selectedId].setIcon(createMarkerIcon(false));
            }
            document.querySelectorAll('.agency-card.selected').forEach(c => c.classList.remove('selected'));

            selectedId = id;
            const a = agencies.find(x => x.id === id);
            if (!a) return;

            // Activate marker
            markers[id].setIcon(createMarkerIcon(true));
            map.flyTo([a.lat, a.lng], 14, { duration: 0.8 });
            markers[id].openPopup();

            // Highlight card
            const card = document.querySelector(`.agency-card[data-id="${id}"]`);
            if (card) {
                card.classList.add('selected');
                card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        // ══════════════════════════════════════════════════════════════════
        // FILTER & SEARCH
        // ══════════════════════════════════════════════════════════════════
        function getFiltered() {
            const q = document.getElementById('searchInput').value.toLowerCase().trim();
            const gov = govFilter.value;
            const openOnly = document.getElementById('openNowFilter').checked;

            let list = agencies.filter(a => {
                if (q && !(a.name.toLowerCase().includes(q) || a.address.toLowerCase().includes(q) || a.gov.toLowerCase().includes(q))) return false;
                if (gov && a.gov !== gov) return false;
                if (openOnly && !isOpenNow(a)) return false;
                return true;
            });

            // Compute distances if user position known
            if (userLatLng) {
                list.forEach(a => { a._dist = haversineKm(userLatLng.lat, userLatLng.lng, a.lat, a.lng); });
                list.sort((a, b) => a._dist - b._dist);
            } else {
                list.forEach(a => { a._dist = null; });
            }

            return list;
        }

        function applyFilters() {
            const filtered = getFiltered();
            renderCards(filtered);

            // Show / hide markers
            agencies.forEach(a => {
                if (filtered.find(f => f.id === a.id)) {
                    if (!map.hasLayer(markers[a.id])) markers[a.id].addTo(map);
                } else {
                    map.removeLayer(markers[a.id]);
                }
            });

            // Fit bounds
            if (filtered.length > 0) {
                const group = L.featureGroup(filtered.map(a => markers[a.id]));
                if (userMarkerLayer) group.addLayer(userMarkerLayer);
                map.fitBounds(group.getBounds().pad(0.15), { maxZoom: 13 });
            }
        }

        document.getElementById('searchInput').addEventListener('input', applyFilters);
        govFilter.addEventListener('change', applyFilters);
        document.getElementById('openNowFilter').addEventListener('change', applyFilters);

        // ══════════════════════════════════════════════════════════════════
        // GEOLOCATION
        // ══════════════════════════════════════════════════════════════════
        const geoBtn = document.getElementById('geoBtn');
        geoBtn.addEventListener('click', function () {
            if (!navigator.geolocation) {
                alert("La géolocalisation n'est pas supportée par votre navigateur.");
                return;
            }

            geoBtn.classList.add('loading');
            geoBtn.innerHTML = '<i data-lucide="loader-2" class="h-5 w-5 animate-spin"></i> Localisation en cours...';
            if (window.lucide) window.lucide.createIcons();

            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    userLatLng = { lat: pos.coords.latitude, lng: pos.coords.longitude };

                    // User marker
                    if (userMarkerLayer) map.removeLayer(userMarkerLayer);
                    userMarkerLayer = L.marker([userLatLng.lat, userLatLng.lng], {
                        icon: L.divIcon({
                            className: '',
                            html: '<div class="user-marker"></div>',
                            iconSize: [18, 18],
                            iconAnchor: [9, 9]
                        })
                    }).addTo(map).bindPopup('<div class="popup-inner"><h3>Vous êtes ici</h3></div>');

                    geoBtn.classList.remove('loading');
                    geoBtn.innerHTML = '<i data-lucide="check-circle" class="h-5 w-5"></i> Position détectée';
                    if (window.lucide) window.lucide.createIcons();

                    setTimeout(() => {
                        geoBtn.innerHTML = '<i data-lucide="locate-fixed" class="h-5 w-5"></i> Me géolocaliser';
                        if (window.lucide) window.lucide.createIcons();
                    }, 3000);

                    applyFilters();
                },
                (err) => {
                    geoBtn.classList.remove('loading');
                    geoBtn.innerHTML = '<i data-lucide="locate-fixed" class="h-5 w-5"></i> Me géolocaliser';
                    if (window.lucide) window.lucide.createIcons();
                    alert("Impossible de déterminer votre position. Veuillez autoriser la géolocalisation dans votre navigateur.");
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        });

        // ── Initial render ────────────────────────────────────────────
        applyFilters();
    });
    </script>
}
