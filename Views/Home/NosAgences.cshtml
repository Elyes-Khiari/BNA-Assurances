            { id: 9,  name: "Agence Sousse Centre",             gov: "Sousse",    address: "Av. Habib Bourguiba, Sousse 4000",                lat: 35.8256, lng: 10.6369, phone: "+216 73 225 400", email: "sousse@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
            { id: 10, name: "Agence Sousse Sahloul",            gov: "Sousse",    address: "Cité Sahloul, Sousse 4054",                       lat: 35.8500, lng: 10.5900, phone: "+216 73 368 100", email: "sahloul@bna-assurances.com.tn", hours: { open: 8, close: 16 } },
