@{
    ViewData["Title"] = "Nos Agences";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        /* ── Map Container ─────────────────────────────────────────────────── */
        #agencyMap {
            height: 100%;
            min-height: 500px;
            border-radius: 1.25rem;
            z-index: 1;
        }

        /* ── Custom Marker Pulse ───────────────────────────────────────────── */
        .bna-marker {
            width: 32px; height: 32px;
            background: #00A86B;
            border: 3px solid #fff;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0,168,107,.45);
            transition: transform .2s, box-shadow .2s;
        }
        .bna-marker.active {
            transform: scale(1.35);
            box-shadow: 0 0 0 8px rgba(0,168,107,.18), 0 2px 12px rgba(0,168,107,.5);
        }

        .user-marker {
            width: 18px; height: 18px;
            background: #3B82F6;
            border: 3px solid #fff;
            border-radius: 50%;
            box-shadow: 0 0 0 6px rgba(59,130,246,.22);
            animation: userPulse 2s infinite;
        }
        @@keyframes userPulse {
            0%, 100% { box-shadow: 0 0 0 6px rgba(59,130,246,.22); }
            50% { box-shadow: 0 0 0 14px rgba(59,130,246,.08); }
        }

        /* ── Sidebar & Cards ──────────────────────────────────────────────── */
        .agency-sidebar {
            max-height: calc(100vh - 12rem);
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #e5e7eb transparent;
        }
        .agency-sidebar::-webkit-scrollbar { width: 5px; }
        .agency-sidebar::-webkit-scrollbar-track { background: transparent; }
        .agency-sidebar::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 99px; }

        .agency-card {
            background: #fff;
            border-radius: 1rem;
            padding: 1.25rem;
            border: 1px solid #f1f5f9;
            cursor: pointer;
            transition: all .25s cubic-bezier(.4,0,.2,1);
        }
        .agency-card:hover {
            border-color: #00A86B33;
            box-shadow: 0 4px 20px rgba(0,168,107,.1);
            transform: translateY(-2px);
        }
        .agency-card.selected {
            border-color: #00A86B;
            box-shadow: 0 4px 24px rgba(0,168,107,.16);
            background: linear-gradient(135deg, #f0fdf4 0%, #fff 100%);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 99px;
        }
        .status-badge.open { background: #dcfce7; color: #15803d; }
        .status-badge.closed { background: #fee2e2; color: #b91c1c; }

        .status-dot { width: 7px; height: 7px; border-radius: 50%; }
        .status-dot.open { background: #22c55e; animation: dotPulse 1.5s infinite; }
        .status-dot.closed { background: #ef4444; }
        @@keyframes dotPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .4; }
        }

        .distance-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 99px;
            background: #eff6ff;
            color: #1d4ed8;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 99px;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #334155;
            transition: all .2s;
            text-decoration: none;
        }
        .action-btn:hover {
            border-color: #00A86B;
            color: #00A86B;
            background: #f0fdf4;
        }
        .action-btn.primary {
            background: #00A86B;
            color: #fff;
            border-color: #00A86B;
        }
        .action-btn.primary:hover {
            background: #007A4D;
            border-color: #007A4D;
        }

        /* ── Geo Button ────────────────────────────────────────────────────── */
        .geo-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 22px;
            background: linear-gradient(135deg, #00A86B 0%, #007A4D 100%);
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            border-radius: 99px;
            border: none;
            cursor: pointer;
            transition: all .25s;
            box-shadow: 0 4px 14px rgba(0,168,107,.3);
        }
        .geo-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0,168,107,.4);
        }
        .geo-btn:active { transform: scale(.97); }
        .geo-btn.loading { opacity: .7; pointer-events: none; }

        /* ── Search & Filter Bar ───────────────────────────────────────────── */
        .search-input {
            width: 100%;
            padding: 12px 16px 12px 44px;
            border: 1px solid #e2e8f0;
            border-radius: 0.875rem;
            font-size: 0.9rem;
            background: #fff;
            transition: all .2s;
            outline: none;
        }
        .search-input:focus {
            border-color: #00A86B;
            box-shadow: 0 0 0 3px rgba(0,168,107,.12);
        }

        .filter-select {
            padding: 10px 14px;
            border: 1px solid #e2e8f0;
            border-radius: 0.875rem;
            font-size: 0.85rem;
            background: #fff;
            cursor: pointer;
            outline: none;
            color: #334155;
            transition: all .2s;
        }
        .filter-select:focus {
            border-color: #00A86B;
            box-shadow: 0 0 0 3px rgba(0,168,107,.12);
        }

        .filter-check {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            color: #475569;
            cursor: pointer;
            user-select: none;
        }
        .filter-check input[type="checkbox"] {
            accent-color: #00A86B;
            width: 16px; height: 16px;
        }

        /* ── Stats Bar ─────────────────────────────────────────────────────── */
        .stats-bar {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }
        .stat-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(255,255,255,.6);
            backdrop-filter: blur(8px);
            border-radius: 99px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #fff;
        }
        .stat-item i { opacity: .8; }

        /* ── Counter badge ─────────────────────────────────────────────────── */
        .results-count {
            font-size: 0.8rem;
            font-weight: 600;
            color: #64748b;
            padding: 6px 0;
        }

        /* ── Leaflet Popup Override ─────────────────────────────────────────  */
        .leaflet-popup-content-wrapper {
            border-radius: 1rem !important;
            box-shadow: 0 8px 30px rgba(0,0,0,.12) !important;
            padding: 0 !important;
        }
        .leaflet-popup-content {
            margin: 0 !important;
            font-family: 'Inter', sans-serif;
        }
        .popup-inner {
            padding: 16px 20px;
        }
        .popup-inner h3 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1rem;
            color: #0D2F5E;
            margin: 0 0 6px;
        }
        .popup-inner p {
            font-size: 0.8rem;
            color: #64748b;
            margin: 0 0 4px;
        }
    </style>
}

<section class="shell-hero">
    <div class="hero-pattern" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <span class="eyebrow-pill border-white/15 bg-white/10 text-white"><i data-lucide="map-pin" class="h-4 w-4"></i> Nos agences</span>
        <h1 class="mt-6 max-w-4xl font-display text-5xl font-extrabold leading-tight md:text-6xl">
            Un réseau national <span class="text-bnaGreen">à portée de main.</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/72">
            Retrouvez l'agence BNA Assurances la plus proche de chez vous parmi nos points de contact répartis sur tout le territoire tunisien.
        </p>
        <div class="stats-bar mt-8">
            <div class="stat-item"><i data-lucide="building-2" class="h-4 w-4"></i> <span id="totalAgencies">0</span> agences</div>
            <div class="stat-item"><i data-lucide="map" class="h-4 w-4"></i> 24 gouvernorats</div>
            <div class="stat-item"><i data-lucide="clock" class="h-4 w-4"></i> Lun — Ven, 8h — 16h</div>
        </div>
    </div>
</section>

<section class="bg-bnaWarm py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center flex-1">
                <div class="relative flex-1 max-w-md">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400 pointer-events-none"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Rechercher une agence, ville ou adresse..." autocomplete="off" />
                </div>
                <select id="govFilter" class="filter-select">
                    <option value="">Tous les gouvernorats</option>
                </select>
                <label class="filter-check">
                    <input type="checkbox" id="openNowFilter" />
                    Ouvertes maintenant
                </label>
            </div>
            <button id="geoBtn" class="geo-btn" type="button">
                <i data-lucide="locate-fixed" class="h-5 w-5"></i>
                Me géolocaliser
            </button>
        </div>

        <div class="results-count mb-3" id="resultsCount"></div>

        <!-- ── Grid : Sidebar + Map ──────────────────────────────────── -->
        <div class="grid gap-6 lg:grid-cols-[0.42fr_1fr]">
            <!-- Sidebar -->
            <div class="agency-sidebar space-y-4" id="agencyList">
                <!-- Cards injected by JS -->
            </div>

            <!-- Map -->
            <div class="relative rounded-[1.25rem] overflow-hidden shadow-lg ring-1 ring-black/5" style="min-height:560px;">
                <div id="agencyMap"></div>
            </div>
        </div>
    </div>
</section>

